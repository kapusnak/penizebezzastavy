NEXT_PUBLIC_SITE_URL=https://penizebezzastavy.cz

# SMTP (Spacemail) — jen na serveru (Railway Variables). Nikdy NEXT_PUBLIC_*.
# Schránka zůstává info@docasnyvykup.cz; From display name je penizebezzastavy.cz.
SMTP_HOST=mail.spacemail.com
SMTP_PORT=465
SMTP_USER=info@docasnyvykup.cz
SMTP_PASS=
LEAD_NOTIFY_TO=info@docasnyvykup.cz
# MAIL_FROM="penizebezzastavy.cz <info@docasnyvykup.cz>"

# Analytics (volitelné). NEXT_PUBLIC_* musí být nastavené před buildem.
NEXT_PUBLIC_GTM_ID=
NEXT_PUBLIC_GA_MEASUREMENT_ID=
